rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny everything. All writes go through server API routes
    // (firebase-admin bypasses these rules), so clients are read-only here.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        memberDoc(workspaceId).data.status == 'active';
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) &&
        memberDoc(workspaceId).data.role == 'admin';
    }

    // --- users/{uid} ---
    // Read own profile. Only cosmetic fields may be changed by the client;
    // role, status, workspace and email are server-managed.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt', 'lastLoginAt']);
      allow delete: if false;
    }

    // --- workspaces/{workspaceId} ---
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if false;

      // --- workspaces/{workspaceId}/members/{memberUid} ---
      match /members/{memberUid} {
        allow read: if isWorkspaceAdmin(workspaceId) ||
          (isOwner(memberUid) && isWorkspaceMember(workspaceId));
        allow write: if false;
      }
    }

    // --- invitations: server only ---
    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    // --- leads/{leadId}: admins see the workspace, others only leads assigned to them ---
    match /leads/{leadId} {
      allow read: if isAuthenticated() &&
        resource.data.workspaceId != null &&
        (isWorkspaceAdmin(resource.data.workspaceId) ||
          (isWorkspaceMember(resource.data.workspaceId) &&
            resource.data.assignedToId == request.auth.uid));
      allow write: if false;
    }

    // --- sequences/{sequenceId} ---
    match /sequences/{sequenceId} {
      allow read: if isAuthenticated() &&
        resource.data.workspaceId != null &&
        (isWorkspaceAdmin(resource.data.workspaceId) ||
          (isWorkspaceMember(resource.data.workspaceId) &&
            (resource.data.createdByUid == request.auth.uid ||
              (resource.data.approvalStatus == 'approved' &&
                resource.data.get('isCustom', false) == false))));
      allow write: if false;
    }

    // tasks, activities, auditLogs: server only (covered by default deny)
  }
}
