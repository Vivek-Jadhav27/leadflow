# ==============================================================================
# LeadFlow Environment Configuration Reference
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure corresponding environment variables in your Vercel Project Settings for production.
# NEVER commit sensitive API keys or service account credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# Used for constructing invitation acceptance and password reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Public Web Configuration)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Privileged Operations)
# ------------------------------------------------------------------------------
# Used by Next.js Server Routes for atomic user creation, workspace provisioning,
# role enforcement, and token verification.
#
# Option A: Single JSON String (Recommended for Vercel deployment)
# Paste the minified service account JSON downloaded from:
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Option B: Individual Service Account Variables (Alternative)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Transactional Email Service
# ------------------------------------------------------------------------------
# Used for SDR invitation emails and system notifications.
EMAIL_FROM="LeadFlow <noreply@yourdomain.com>"

# Option A: Resend HTTP API (Recommended for Vercel)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_resend_api_key

# Option B: Standard SMTP (SendGrid, Postmark, Mailgun, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
SMTP_SECURE=false

# In local development without external credentials, the email service logs
# full invitation links directly to the console for testing zero-setup workflows.

